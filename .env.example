# Copy this file to .env and fill in the values. .env is not committed.
# Ports are chosen not to clash with sales (8080, DB 5432/5433) and tickets (8081, DB 5432).

# ==================================================
# Spring Boot / Database
# ==================================================
NOTIFICATIONS_PORT=8082
NOTIFICATIONS_DB_HOST=localhost
NOTIFICATIONS_DB_PORT=5434
NOTIFICATIONS_DB_NAME=notifications
NOTIFICATIONS_DB_USER=change_me
NOTIFICATIONS_DB_PASSWORD=change_me

# ==================================================
# pgAdmin
# ==================================================
NOTIFICATIONS_PGADMIN_EMAIL=admin@example.com
NOTIFICATIONS_PGADMIN_PASSWORD=change_me
NOTIFICATIONS_PGADMIN_PORT=5052

# ==================================================
# RabbitMQ (same credentials as rabbitMQ/.env)
# ==================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=change_me
RABBITMQ_DEFAULT_PASS=change_me
